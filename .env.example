# Local-only sample. Never commit an actual .env file.
LEARNFLEX_DEMO_STUDENT_PASSWORD=replace-with-a-unique-local-student-password
# Mandatory in production; at least 16 characters. Store in host secret manager.
LEARNFLEX_DEMO_TEACHER_PASSWORD=replace-with-a-unique-16-character-or-longer-secret
# JSON object mapping invite codes to authoritative school/class/section metadata.
LEARNFLEX_STUDENT_INVITES={"REPLACE_WITH_RANDOM_INVITE":{"school":"Approved School Name","className":"Class 8","section":"A","maxUses":30}}
LEARNFLEX_RETENTION_DAYS=365
